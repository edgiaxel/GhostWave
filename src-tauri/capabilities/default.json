{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "GhostWave default capability scoping filesystem access to user music and download folders",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "fs:allow-read",
      "allow": [
        { "path": "$MUSIC/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" }
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        { "path": "$MUSIC/**" }
      ]
    }
  ]
}
